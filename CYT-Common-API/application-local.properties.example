# Copy to application-local.properties; never commit real credentials.
server.address=127.0.0.1
server.port=8189
spring.datasource.url=${POSTGRES_URL:jdbc:postgresql://127.0.0.1:5432/cyt_common_api_java}
spring.datasource.username=${POSTGRES_USERNAME:cyt_gateway}
spring.datasource.password=${POSTGRES_PASSWORD:}
ENV=local
MOCK_ALL=true
GATEWAY_DEV_MODE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
CREDENTIAL_MASTER_KEY=

# Explicit trusted internal service origins; empty keeps private networks blocked.
INTERNAL_API_ALLOWED_ORIGINS=

# Raw NAS proxy upload (bytes / seconds)
NAS_UPLOAD_MAX_BYTES=536870912
NAS_UPLOAD_TIMEOUT_S=300
