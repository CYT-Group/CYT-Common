# Java backend does not read ../.env. Inject these variables into the process.
HOST=127.0.0.1
PORT=8189
ENV=local
SPRING_PROFILES_ACTIVE=local
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/cyt_common_api_java
POSTGRES_USERNAME=cyt_gateway
POSTGRES_PASSWORD=
MOCK_ALL=true
GATEWAY_DEV_MODE=false
JAVA_SEED_ENABLED=true
ADMIN_AUTH_MODES=admin_jwt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
CREDENTIAL_MASTER_KEY=
REDIS_URL=

# Explicit trusted internal service origins; empty keeps private networks blocked.
INTERNAL_API_ALLOWED_ORIGINS=
